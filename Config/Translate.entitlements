<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the Safari extension so it can read the live captions (CaptionFeed).
	     iOS and visionOS need a "group." identifier; macOS uses the team-prefixed form, which
	     works without a provisioning profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(CAPTION_APP_GROUP)</string>
	</array>
</dict>
</plist>
